---
import Layout from '../layouts/Layout.astro';
import PricingSection from '../components/PricingSection.astro';
import { whatsappUrl } from '../data/academy';
---
<Layout title="Harga Layanan — Archa Edu Academy" description="Pilihan pendampingan akademik, bantuan kuliah, dan layanan pendukung. Lihat rincian harga dan konsultasikan kebutuhan Anda melalui WhatsApp.">
  <main>
    <section class="ae-page-intro"><span class="ae-eyebrow">Harga Transparan</span><h1>Pendampingan yang sesuai kebutuhan Anda.</h1><p>Diskusikan kebutuhan, jadwal, dan ruang lingkup sebelum memulai.</p></section>
    <PricingSection />
    <section class="ae-policy" aria-labelledby="order-title">
      <h2 id="order-title">Cara memulai</h2>
      <ol><li>Pilih layanan dan buka konsultasi WhatsApp.</li><li>Sampaikan kebutuhan serta tenggat Anda.</li><li>Sepakati biaya, ruang lingkup, dan jadwal bersama tim.</li><li>Lakukan DP 50% sesuai instruksi pembayaran yang diberikan melalui chat.</li></ol>
      <h2>Pertanyaan tentang biaya</h2>
      <details class="faq-item"><summary>Mengapa sebagian harga berupa rentang?</summary><p>Biaya akhir disepakati setelah tim mengetahui kebutuhan dan ruang lingkup pendampingan Anda.</p></details>
      <details class="faq-item"><summary>Bagaimana ketentuan revisi dan pembayaran?</summary><p>Diskusikan cakupan revisi, jadwal, dan ketentuan pembayaran sebelum booking. Informasi pembayaran diberikan melalui WhatsApp.</p></details>
      <details class="faq-item"><summary>Apakah tersedia layanan lain?</summary><p>Sampaikan kebutuhan Anda melalui konsultasi agar tim dapat menjelaskan pilihan dan biayanya.</p></details>
      <p><a class="ae-button" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Konsultasi dengan Tim</a></p>
    </section>
  </main>
</Layout>
