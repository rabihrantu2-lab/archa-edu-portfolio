---
import Layout from '../layouts/Layout.astro';

const title = "Harga Paket Bimbingan Skripsi - Archa Edu Academy";
const description = "Harga transparan paket Basic, Reguler, dan Premium. DP 50%, tidak ada biaya tersembunyi. Mulai Rp 500.000.";

const waNomor = "62895323665266";

const paket = [
  {
    nama: "Basic",
    ikon: "📘",
    harga: "Rp 500.000",
    hargaAsli: "",
    periode: "/paket",
    deskripsi: "Untuk kamu yang hanya butuh arahan di tahap tertentu.",
    fitur: [
      "Konsultasi awal gratis",
      "Bimbingan 2 sesi",
      "Review 1 bab",
      "Template & panduan"
    ],
    populer: false,
    badge: ""
  },
  {
    nama: "Reguler",
    ikon: "⭐",
    harga: "Rp 2.500.000",
    hargaAsli: "Rp 3.100.000",
    periode: "/paket",
    deskripsi: "Pendampingan penuh dari bab 1 sampai siap sidang.",
    fitur: [
      "Semua fitur Basic",
      "Bimbingan 1-on-1 rutin",
      "Review semua bab",
      "Simulasi sidang",
      "Garansi revisi"
    ],
    populer: true,
    badge: "Hemat 20%"
  },
  {
    nama: "Premium",
    ikon: "👑",
    harga: "Rp 4.500.000",
    hargaAsli: "",
    periode: "/paket",
    deskripsi: "Pendampingan penuh + prioritas jadwal + simulasi intensif.",
    fitur: [
      "Semua fitur Reguler",
      "Prioritas jadwal konsultan",
      "Simulasi sidang intensif",
      "Bantuan publikasi jurnal",
      "Pendampingan sampai lulus"
    ],
    populer: false,
    badge: ""
  }
];

const addons = [
  { ikon: "📝", nama: "Parafrase & Editing", desc: "Perbaiki tata bahasa, ejaan, dan konsistensi tanpa mengubah makna.", harga: "Mulai Rp 150.000" },
  { ikon: "📊", nama: "Olah Data (SPSS/Excel)", desc: "Analisis data kuantitatif atau kualitatif, hasil rapi dan mudah dibaca.", harga: "Mulai Rp 300.000" },
  { ikon: "🔍", nama: "Cek Turnitin", desc: "Cek tingkat kemiripan dokumenmu sebelum submit.", harga: "Mulai Rp 50.000" },
  { ikon: "📚", nama: "Bantu Tugas Tutorial", desc: "Untuk mahasiswa UT: bantuan pengerjaan tugas tutorial dan diskusi.", harga: "Mulai Rp 100.000" },
  { ikon: "🎤", nama: "Latihan Sidang", desc: "Simulasi tanya-jawab dengan konsultan, persiapan mental sebelum sidang.", harga: "Mulai Rp 200.000" },
  { ikon: "📄", nama: "Format & Sitasi", desc: "Rapikan format sesuai pedoman kampus dan atur sitasi otomatis.", harga: "Mulai Rp 100.000" }
];

const faqHarga = [
  { q: "Apakah bisa dicicil?", a: "Bisa. Kami menerapkan sistem DP 50% di awal, dan sisanya bisa dilunasi setelah pekerjaan selesai atau sesuai kesepakatan." },
  { q: "Apakah ada biaya tambahan?", a: "Tidak ada biaya tersembunyi. Harga yang tertera sudah mencakup semua layanan yang tertulis di paket. Jika ada permintaan khusus, akan didiskusikan terlebih dahulu." },
  { q: "Bagaimana kalau saya ingin ganti paket?", a: "Kamu bisa mengganti paket selama proses pendampingan belum dimulai. Jika sudah berjalan, akan disesuaikan dengan progres yang sudah dikerjakan." },
  { q: "Apakah bisa bantu tugas tutorial UT?", a: "Bisa. Kami membantu pengerjaan tugas tutorial, diskusi, dan tugas mata kuliah lainnya. Silakan konsultasikan dulu materinya." }
];
---

<Layout title={title} description={description}>
  <main>
    <!-- HERO SECTION -->
    <section class="hero-harga">
      <span class="pill">💰 Harga Transparan</span>
      <h1>Investasi untuk Masa Depanmu</h1>
      <p>Semua paket sudah termasuk konsultasi awal gratis. DP 50%, sisanya setelah selesai. Tanpa biaya tersembunyi.</p>
    </section>

    <!-- GRID HARGA SECTION -->
    <section class="section-container">
      <div class="grid-harga">
        {paket.map((item) => (
          <div class={`card-harga ${item.populer ? 'populer' : ''}`}>
            {item.populer && <span class="label-populer">★ PALING POPULER</span>}
            {item.badge && <span class="badge-hemat">{item.badge}</span>}
            <div class="ikon-paket">{item.ikon}</div>
            <h3>{item.nama}</h3>
            <p class="deskripsi-paket">{item.deskripsi}</p>
            {item.hargaAsli && <p class="harga-asli">{item.hargaAsli}</p>}
            <div class="harga-nominal">{item.harga} <span>{item.periode}</span></div>
            <ul>
              {item.fitur.map((f) => <li><span class="check">✓</span> {f}</li>)}
            </ul>
            <a href={`https://wa.me/${waNomor}?text=Halo,%20saya%20tertarik%20dengan%20paket%20${item.nama}`} class="btn-pilih" target="_blank">Pilih Paket Ini</a>
          </div>
        ))}
      </div>
      <p class="catatan-harga">*Harga dapat berubah sesuai tingkat kesulitan dan deadline. Konsultasi dulu untuk penawaran pasti.</p>
    </section>

    <!-- TABEL PERBANDINGAN FITUR -->
    <section class="section-container">
      <div class="section-header">
        <h2>Bandingkan Paket</h2>
        <p>Lihat dengan jelas apa yang kamu dapatkan di setiap paket.</p>
      </div>
      <div class="tabel-wrapper">
        <table class="tabel-perbandingan">
          <thead>
            <tr>
              <th>Fitur</th>
              <th>Basic</th>
              <th class="highlight">⭐ Reguler</th>
              <th>Premium</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Konsultasi Awal</td><td>✓</td><td>✓</td><td>✓</td></tr>
            <tr><td>Bimbingan 1-on-1</td><td>2 sesi</td><td>Rutin</td><td>Prioritas</td></tr>
            <tr><td>Review Bab</td><td>1 bab</td><td>Semua bab</td><td>Semua bab</td></tr>
            <tr><td>Simulasi Sidang</td><td>—</td><td>✓</td><td>Intensif</td></tr>
            <tr><td>Garansi Revisi</td><td>—</td><td>✓</td><td>✓</td></tr>
            <tr><td>Bantuan Publikasi</td><td>—</td><td>—</td><td>✓</td></tr>
            <tr><td>Pendampingan</td><td>—</td><td>Sampai sidang</td><td>Sampai lulus</td></tr>
            <tr><td>Estimasi Waktu</td><td>2-4 minggu</td><td>2-4 bulan</td><td>Fleksibel</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- LAYANAN TAMBAHAN (ADD-ON) -->
    <section class="section-container bg-alt">
      <div class="section-header">
        <h2>Layanan Satuan</h2>
        <p>Tidak perlu paket lengkap? Pilih layanan satuan sesuai kebutuhanmu.</p>
      </div>
      <div class="grid-addon">
        {addons.map((item) => (
          <div class="card-addon">
            <div class="addon-ikon">{item.ikon}</div>
            <h3>{item.nama}</h3>
            <p>{item.desc}</p>
            <span class="harga-addon">{item.harga}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- TRUST BADGE -->
    <section class="trust-section">
      <div class="trust-badge">
        <span>⭐ 4.9/5 Rating</span>
        <span>👥 500+ Mahasiswa Terbantu</span>
        <span>🔒 100% Rahasia Terjaga</span>
        <span>⚡ Respon Cepat 1x24 Jam</span>
      </div>
    </section>

    <!-- METODE PEMBAYARAN -->
    <section class="section-container bg-alt">
      <div class="section-header">
        <h2>💳 Cara Pembayaran</h2>
        <p>Kami menerima berbagai metode pembayaran untuk kemudahanmu.</p>
      </div>
      <div class="grid-pembayaran">
        <div class="card-pembayaran">
          <h3>🏦 Transfer Bank</h3>
          <p>BCA, Mandiri, BNI, BRI</p>
        </div>
        <div class="card-pembayaran">
          <h3>📱 E-Wallet</h3>
          <p>GoPay, OVO, Dana, ShopeePay</p>
        </div>
        <div class="card-pembayaran">
          <h3>💳 QRIS</h3>
          <p>Scan & bayar langsung (segera hadir)</p>
        </div>
      </div>
      <p class="catatan-pembayaran">💡 DP 50% di awal, pelunasan setelah pekerjaan selesai.</p>
    </section>

    <!-- PROSES SINGKAT -->
    <section class="section-container">
      <div class="proses-singkat">
        <h3>🚀 Cara Pesan (6 Langkah Mudah)</h3>
        <div class="proses-steps">
          <span>1. Chat WA</span>
          <span>→</span>
          <span>2. Kirim Detail</span>
          <span>→</span>
          <span>3. Dapat Penawaran</span>
          <span>→</span>
          <span>4. DP 50%</span>
          <span>→</span>
          <span>5. Dikerjakan</span>
          <span>→</span>
          <span>6. Pelunasan</span>
        </div>
      </div>
    </section>

    <!-- FAQ HARGA SECTION -->
    <section class="section-container">
      <div class="section-header">
        <h2>❓ FAQ Harga</h2>
        <p>Pertanyaan yang sering diajukan seputar biaya layanan.</p>
      </div>
      <div class="faq-list">
        {faqHarga.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA AKHIR -->
    <section class="cta-akhir">
      <h2>Butuh Paket Custom?</h2>
      <p>Ceritakan kebutuhanmu, kami akan buatkan penawaran khusus yang sesuai dengan kondisi dan budgetmu.</p>
      <a href={`https://wa.me/${waNomor}?text=Halo,%20saya%20butuh%20paket%20custom`} class="btn-primary" target="_blank">💬 Hubungi Kami</a>
    </section>
  </main>
</Layout>

<style>
  /* Hero Harga */
  .hero-harga { text-align: center; padding: 5rem 2rem 3rem; max-width: 800px; margin: 0 auto; }
  .hero-harga h1 { font-size: 2.5rem; color: var(--text-main); margin-bottom: 1rem; }
  .hero-harga p { font-size: 1.2rem; color: var(--text-muted); }
  .pill { background: var(--accent-color); color: white; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; display: inline-block; margin-bottom: 1rem; }

  /* Section */
  .section-container { padding: 3rem 2rem 5rem; max-width: 1200px; margin: 0 auto; }
  .bg-alt { background-color: var(--card-bg); border-radius: 16px; margin: 0 auto 3rem; max-width: 1200px; }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-header h2 { font-size: 2rem; color: var(--text-main); margin-bottom: 0.5rem; }
  .section-header p { color: var(--text-muted); }

  /* Grid Harga */
  .grid-harga { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; align-items: start; }
  .card-harga { background: var(--card-bg); border: 1px solid var(--border-color); padding: 2.5rem 2rem; border-radius: 16px; text-align: center; position: relative; transition: all 0.3s ease; }
  .card-harga:hover { transform: translateY(-8px); box-shadow: 0 20px 25px -5px rgba(22, 135, 123, 0.2); border-color: var(--accent-color); }
  .card-harga.populer { border: 2px solid var(--accent-color); transform: scale(1.05); box-shadow: 0 10px 30px -5px rgba(22, 135, 123, 0.3); }
  .card-harga.populer:hover { transform: scale(1.05) translateY(-8px); }
  .label-populer { background: linear-gradient(135deg, #16877b, #116b61); color: white; padding: 6px 16px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; position: absolute; top: -15px; left: 50%; transform: translateX(-50%); white-space: nowrap; letter-spacing: 1px; }
  .badge-hemat { background: #ef4444; color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: bold; position: absolute; top: 1rem; right: 1rem; }
  
  .ikon-paket { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .card-harga h3 { color: var(--text-main); font-size: 1.3rem; text-transform: uppercase; letter-spacing: 2px; margin-top: 0; margin-bottom: 1rem; }
  .deskripsi-paket { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; min-height: 40px; }
  .harga-asli { color: var(--text-muted); text-decoration: line-through; font-size: 0.9rem; margin: 0; }
  .harga-nominal { font-size: 2.2rem; font-weight: bold; color: var(--text-main); margin-bottom: 2rem; }
  .harga-nominal span { font-size: 0.9rem; font-weight: normal; color: var(--text-muted); }
  
  .card-harga ul { list-style: none; padding: 0; text-align: left; margin-bottom: 2rem; }
  .card-harga li { padding: 0.7rem 0; color: var(--text-muted); font-size: 0.95rem; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.5rem; }
  .card-harga li:last-child { border-bottom: none; }
  .check { color: var(--accent-color); font-weight: bold; }
  
  .btn-pilih { display: block; width: 100%; padding: 14px; background: linear-gradient(135deg, #16877b, #116b61); color: white; text-decoration: none; border-radius: 8px; font-weight: bold; box-sizing: border-box; transition: all 0.3s; box-shadow: 0 4px 6px rgba(22, 135, 123, 0.3); }
  .btn-pilih:hover { transform: translateY(-2px); box-shadow: 0 8px 12px rgba(22, 135, 123, 0.4); }

  .catatan-harga { text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-top: 1.5rem; font-style: italic; }

  /* Tabel Perbandingan */
  .tabel-wrapper { overflow-x: auto; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
  .tabel-perbandingan { width: 100%; border-collapse: collapse; background: var(--card-bg); min-width: 600px; }
  .tabel-perbandingan th, .tabel-perbandingan td { padding: 1rem; text-align: center; border-bottom: 1px solid var(--border-color); color: var(--text-muted); }
  .tabel-perbandingan th { background: var(--bg-color); color: var(--text-main); font-weight: bold; font-size: 0.9rem; }
  .tabel-perbandingan th.highlight { background: linear-gradient(135deg, #16877b, #116b61); color: white; }
  .tabel-perbandingan td:first-child { text-align: left; font-weight: 500; color: var(--text-main); }
  .tabel-perbandingan tr:hover { background: rgba(22, 135, 123, 0.08); }

  /* Add-on */
  .grid-addon { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
  .card-addon { background: var(--bg-color); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-color); display: flex; flex-direction: column; transition: all 0.3s; }
  .card-addon:hover { transform: translateY(-5px); border-color: var(--accent-color); box-shadow: 0 10px 20px rgba(22, 135, 123, 0.15); }
  .addon-ikon { font-size: 2rem; margin-bottom: 0.5rem; }
  .card-addon h3 { margin-top: 0; color: var(--text-main); font-size: 1rem; }
  .card-addon p { color: var(--text-muted); font-size: 0.9rem; flex-grow: 1; line-height: 1.5; }
  .harga-addon { display: inline-block; margin-top: 1rem; font-weight: bold; color: var(--accent-color); font-size: 1.1rem; }

  /* Trust Badge */
  .trust-section { padding: 2rem; background: var(--bg-color); }
  .trust-badge { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; max-width: 1000px; margin: 0 auto; }
  .trust-badge span { background: var(--card-bg); padding: 12px 24px; border-radius: 30px; border: 1px solid var(--border-color); color: var(--text-muted); font-weight: 500; font-size: 0.9rem; transition: all 0.3s; }
  .trust-badge span:hover { border-color: var(--accent-color); color: var(--accent-color); transform: translateY(-3px); }

  /* Pembayaran */
  .grid-pembayaran { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
  .card-pembayaran { background: var(--bg-color); padding: 1.5rem; border-radius: 12px; text-align: center; border: 1px solid var(--border-color); transition: all 0.3s; }
  .card-pembayaran:hover { border-color: var(--accent-color); }
  .card-pembayaran h3 { margin-top: 0; color: var(--text-main); font-size: 1.1rem; }
  .card-pembayaran p { color: var(--text-muted); font-size: 0.9rem; margin: 0; }
  .catatan-pembayaran { text-align: center; color: var(--accent-color); font-weight: bold; }

  /* Proses Singkat */
  .proses-singkat { background: var(--bg-color); padding: 2rem; border-radius: 12px; text-align: center; border: 1px solid var(--border-color); margin-bottom: 3rem; }
  .proses-singkat h3 { margin-top: 0; color: var(--text-main); }
  .proses-steps { display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; }
  .proses-steps span { color: var(--text-muted); font-size: 0.9rem; padding: 6px 12px; background: var(--card-bg); border-radius: 20px; }
  .proses-steps span:nth-child(even) { background: transparent; color: var(--accent-color); font-weight: bold; }

  /* FAQ Accordion */
  .faq-list { max-width: 800px; margin: 0 auto; }
  .faq-item { background: var(--card-bg); padding: 1.2rem 1.5rem; border-radius: 12px; border: 1px solid var(--border-color); margin-bottom: 1rem; transition: all 0.3s; }
  .faq-item:hover { border-color: var(--accent-color); }
  .faq-item summary { color: var(--text-main); font-weight: bold; font-size: 1.05rem; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::after { content: '▼'; font-size: 0.7rem; color: var(--accent-color); transition: transform 0.3s; }
  .faq-item[open] summary::after { transform: rotate(180deg); }
  .faq-item p { color: var(--text-muted); margin: 1rem 0 0; line-height: 1.6; font-size: 0.95rem; }

  /* CTA Akhir */
  .cta-akhir { text-align: center; padding: 5rem 2rem; background: linear-gradient(135deg, var(--card-bg) 0%, rgba(22, 135, 123, 0.1) 100%); border-top: 1px solid var(--border-color); }
  .cta-akhir h2 { color: var(--text-main); margin-bottom: 1rem; }
  .cta-akhir p { color: var(--text-muted); margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto; }
  .btn-primary { background: linear-gradient(135deg, #16877b, #116b61); color: white; padding: 14px 28px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block; transition: all 0.3s; box-shadow: 0 4px 6px rgba(22, 135, 123, 0.3); }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 12px rgba(22, 135, 123, 0.4); }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-harga h1 { font-size: 1.8rem; }
    .hero-harga p { font-size: 1rem; }
    .section-container { padding: 2rem 1rem 3rem; }
    .bg-alt { padding: 2rem 1rem; border-radius: 12px; }
    .grid-harga { grid-template-columns: 1fr; gap: 1.5rem; }
    .card-harga { padding: 2rem 1.5rem; }
    .card-harga.populer { transform: scale(1); }
    .card-harga.populer:hover { transform: translateY(-5px); }
    .harga-nominal { font-size: 1.8rem; }
    .section-header h2 { font-size: 1.6rem; }
    .trust-badge { gap: 0.5rem; }
    .trust-badge span { padding: 8px 14px; font-size: 0.8rem; }
    .proses-steps { font-size: 0.8rem; gap: 0.3rem; }
    .proses-steps span { padding: 4px 10px; }
    .cta-akhir { padding: 3rem 1rem; }
    .cta-akhir h2 { font-size: 1.5rem; }
  }
</style>