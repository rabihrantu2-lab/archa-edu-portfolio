---
import Layout from '../layouts/Layout.astro';

const title = "Layanan Konsultasi Mahasiswa - Archa Edu Academy";
const description = "5 layanan konsultasi: tugas akhir, latihan sidang, parafrase, analisis data, dan cek plagiarisme.";

const layanan = [
  { 
    nama: "Konsultasi Karil, Metopen, Proyek, BTA & Tesis", 
    desc: "Menyelesaikan masalah yang terjadi, Membantu mengarahkan langkah selanjutnya untuk menyelesaikan.", 
    durasi: "1-2 hari", 
    harga: "Rp 100.000",
    kategori: "Skripsi",
    badge: ""
  },
  { 
    nama: "Bimbingan Tugas Akhir", 
    desc: "Pendampingan menyeluruh dari penentuan judul, Metode, Penyusunan Proposal, Persiapan sidang, Sampai Final. Bebas revisi.", 
    durasi: "3-6 bulan", 
    harga: "Rp 1.000.000",
    kategori: "Skripsi",
    badge: "Populer"
  },
  { 
    nama: "Latihan sidang/persentasi", 
    desc: "Simulasi sidang/persentasi dengan pertanyaan dosen penguji. Latih mental dan kesiapanmu.", 
    durasi: "1-2 hari", 
    harga: "Rp 200.000",
    kategori: "Skripsi",
    badge: "Hot"
  },
  { 
    nama: "Parafrase, Analisis data, Turnitin", 
    desc: "Jika membutuhkan parafrase Ai score, Turnitin dan analisis data untuk mengolah data kuanti atau kuali dengan SPSS, R, Python, SmartPLS atau Excel.", 
    durasi: "4-7 hari", 
    harga: "Rp 500.000",
    kategori: "Data",
    badge: ""
  },
  { 
    nama: "Cek Plagiarisme", 
    desc: "Pengecekan kemiripan naskah dengan Turnitin, dapatkan laporan resmi dan saran perbaikan.", 
    durasi: "2-3 hari", 
    harga: "Rp 100.000",
    kategori: "Bahasa",
    badge: ""
  }
];

const keunggulan = [
  { icon: "⏳", title: "Konsultan Berpengalaman", desc: "" },
  { icon: "💰", title: "Harga Transparan", desc: "" },
  { icon: "⚡", title: "Respon Cepat", desc: "Dibalas maksimal 1x24 jam, biasanya kurang dari 1 jam." },
  { icon: "🔒", title: "100% Rahasia", desc: "" }
];
---

<Layout title={title} description={description}>
  <main>
    <!-- HERO SECTION -->
    <section class="hero-layanan">
      <span class="pill">🚀 5 Paket Harga Tersedia</span>
      <h1>Layanan Konsultasi Mahasiswa</h1>
      <p>Pilih paket sesuai kebutuhanmu. Semua paket sudah termasuk konsultasi awal.</p>
      
      <div class="stats-bar">
        <span>⭐ 4.9/5 Rating</span>
        <span>👥 500+ Mahasiswa</span>
        <span>⚡ Respon 1x24 Jam</span>
        <span>🔒 100% Rahasia</span>
      </div>
    </section>

    <!-- GRID LAYANAN -->
    <section class="section-container">
      <div class="grid-layanan">
        {layanan.map((item) => (
          <div class="card-layanan">
            <div class="card-header">
              <span class="kategori-badge">{item.kategori}</span>
              {item.badge && <span class="badge-hot">{item.badge}</span>}
            </div>
            <h3>{item.nama}</h3>
            <p>{item.desc}</p>
            <div class="meta-info">
              <span>⏱ {item.durasi}</span>
              <span>💰 Mulai {item.harga}</span>
            </div>
            <a href="/kontak" class="btn-detail">Konsultasi Sekarang &rarr;</a>
          </div>
        ))}
      </div>
    </section>

    <!-- KEUNGGULAN SECTION -->
    <section class="section-container bg-alt">
      <div class="section-header">
        <h2>Kenapa Pilih Kami?</h2>
        <p>Bukan cuma jasa, tapi partner belajarmu.</p>
      </div>
      <div class="grid-keunggulan">
        {keunggulan.map((item) => (
          <div class="card-keunggulan">
            <div class="icon-box">{item.icon}</div>
            <h3>{item.title}</h3>
            {item.desc && <p>{item.desc}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-akhir">
      <h2>Tidak yakin pilih yang mana?</h2>
      <p>Ceritakan kondisimu, kami bantu arahkan ke layanan yang paling tepat.</p>
      <a href="https://wa.me/62895323665266" class="btn-primary" target="_blank">Tanya via WhatsApp</a>
    </section>
  </main>
</Layout>

<style>
  /* HERO */
  .hero-layanan { text-align: center; padding: 5rem 2rem 2rem; max-width: 800px; margin: 0 auto; }
  .pill { background: rgba(22, 135, 123, 0.15); color: var(--accent-color); padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; display: inline-block; margin-bottom: 1.5rem; }
  .hero-layanan h1 { font-size: 2.5rem; color: var(--text-main); margin-bottom: 1rem; }
  .hero-layanan p { font-size: 1.1rem; color: var(--text-muted); margin-bottom: 2rem; }
  .stats-bar { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; font-size: 0.9rem; color: var(--text-muted); font-weight: 500; }

  /* GRID LAYANAN */
  .section-container { padding: 2rem 2rem 5rem; max-width: 1200px; margin: 0 auto; }
  .grid-layanan { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .card-layanan { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; display: flex; flex-direction: column; box-shadow: 0 1px 2px rgba(16,28,41,.06); transition: transform 0.25s, box-shadow 0.25s; }
  .card-layanan:hover { transform: translateY(-3px); box-shadow: 0 10px 24px -8px rgba(16,28,41,.18); }
  .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; min-height: 28px; }
  .kategori-badge { background: rgba(22, 135, 123, 0.1); color: var(--accent-color); font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; font-weight: bold; text-transform: uppercase; }
  .badge-hot { background: #ea580c; color: #fff; font-size: 0.72rem; padding: 4px 10px; border-radius: 20px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; box-shadow: 0 2px 6px rgba(234,88,12,.35); }
  .card-layanan h3 { color: var(--text-main); margin: 0 0 12px; font-size: 1.2rem; font-weight: 700; line-height: 1.35; }
  .card-layanan p { color: var(--text-muted); line-height: 1.65; flex-grow: 1; margin: 0 0 24px; font-size: 0.95rem; }
  .meta-info { display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 16px; margin-bottom: 16px; gap: 12px; flex-wrap: wrap; }
  .btn-detail { display: inline-block; color: var(--accent-color); font-weight: bold; text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
  .btn-detail:hover { color: var(--accent-hover); }

  /* KEUNGGULAN */
  .bg-alt { background-color: var(--card-bg); border-radius: 16px; padding: 4rem 2rem; margin: 0 auto; max-width: 1200px; }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-header h2 { font-size: 2rem; color: var(--text-main); margin-bottom: 0.5rem; }
  .section-header p { color: var(--text-muted); }
  .grid-keunggulan { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; }
  .card-keunggulan { text-align: center; padding: 28px 24px; background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 1px 2px rgba(16,28,41,.06); transition: transform 0.25s, box-shadow 0.25s; }
  .card-keunggulan:hover { transform: translateY(-3px); box-shadow: 0 10px 24px -8px rgba(16,28,41,.18); }
  .icon-box { font-size: 2.5rem; margin-bottom: 1rem; }
  .card-keunggulan h3 { color: var(--text-main); margin-bottom: 0.5rem; }
  .card-keunggulan p { color: var(--text-muted); line-height: 1.6; font-size: 0.95rem; }

  /* CTA AKHIR */
  .cta-akhir { text-align: center; padding: 5rem 2rem; background-color: var(--bg-color); border-top: 1px solid var(--border-color); }
  .cta-akhir h2 { color: var(--text-main); margin-bottom: 1rem; }
  .cta-akhir p { color: var(--text-muted); margin-bottom: 2rem; }
  .btn-primary { background-color: var(--accent-color); color: white; padding: 14px 28px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block; transition: background 0.3s; }
  .btn-primary:hover { background-color: var(--accent-hover); }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero-layanan { padding: 3rem 1rem 1.5rem; }
    .hero-layanan h1 { font-size: 1.8rem; }
    .hero-layanan p { font-size: 1rem; }
    .stats-bar { gap: 0.75rem; font-size: 0.8rem; }
    .section-container { padding: 1.5rem 1rem 3rem; }
    .bg-alt { padding: 2rem 1rem; border-radius: 12px; }
    .grid-layanan { grid-template-columns: 1fr; }
    .section-header h2 { font-size: 1.6rem; }
    .cta-akhir { padding: 3rem 1rem; }
    .cta-akhir h2 { font-size: 1.5rem; }
  }
</style>
