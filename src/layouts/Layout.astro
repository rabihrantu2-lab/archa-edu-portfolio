---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';
import '../styles/brand.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/sky.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Archa Edu Academy — Konsultasi Akademik',
  description = 'Pendampingan skripsi, tesis, analisis data, dan publikasi jurnal. Konsultasi pertama gratis dan harga transparan.'
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      let theme = null;
      try { theme = localStorage.getItem('theme'); } catch {}
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const dark = theme === 'dark' || (theme !== 'light' && systemDark);
      document.documentElement.classList.toggle('dark', dark);
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Langsung ke konten</a>
    <Header />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>
