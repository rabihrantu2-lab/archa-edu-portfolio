---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';
import '../styles/brand.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Archa Edu Academy — Konsultasi Akademik',
  description = 'Pendampingan skripsi, tesis, analisis data, dan publikasi jurnal. Konsultasi pertama gratis dan harga transparan.'
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        const dark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Langsung ke konten</a>
    <Header />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer />
  </body>
</html>
