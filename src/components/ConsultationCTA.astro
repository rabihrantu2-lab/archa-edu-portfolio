---
interface Props {
  title?: string;
  description?: string;
  label?: string;
}
const {
  title = 'Mulai dari satu percakapan.',
  description = 'Ceritakan kendala akademikmu. Kami bantu petakan langkah berikutnya melalui konsultasi pertama gratis.',
  label = 'Konsultasi Gratis via WhatsApp'
} = Astro.props;
---
<section class="cta-akhir">
  <h2>{title}</h2>
  <p>{description}</p>
  <a href="https://wa.me/62895323665266" class="btn-primary" target="_blank" rel="noopener noreferrer">{label} &rarr;</a>
</section>
<style>
  section { text-align:center; }
  a { display:inline-block; text-decoration:none; font-weight:700; }
</style>
